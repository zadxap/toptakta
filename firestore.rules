rules_version = '2';

// ТопТақта — правила безопасности Firestore.
// Вставить в Firebase Console → Firestore Database → Rules (или
// деплоить через workflow «Deploy Firestore rules» с секретами).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberUids;
    }

    // Профили пользователей: читать могут вошедшие (для имён на доске),
    // писать — только владелец профиля.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /groups/{groupId} {
      // Группу видят все вошедшие: по коду нужно уметь найти и присоединиться.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if signedIn()
        && (request.auth.uid in resource.data.memberUids
            || request.auth.uid in request.resource.data.memberUids);
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // Задачи — только участникам группы.
      match /tasks/{taskId} {
        allow read, write: if isMember(groupId);
      }

      // Лента событий: участники читают, пишут только от своего имени,
      // изменять и удалять историю нельзя.
      match /events/{eventId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId)
          && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
